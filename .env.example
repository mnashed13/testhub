# Database (required)
# Managed PostgreSQL — Neon, Supabase, Vercel Postgres, or any Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth (required)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-random-secret-here"  # same value as NEXTAUTH_SECRET

# Default admin user (created on first run via seed script)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-production"

# CI Webhook (auto-generated on first run and stored in DB settings)
# You can pre-set it here, or let the app generate one at /settings
WEBHOOK_SECRET=""

# Optional: Jira & GitHub credentials can also be set here as overrides,
# but are primarily configured via the /settings page and stored in the DB.
# JIRA_BASE_URL="https://your-org.atlassian.net"
# JIRA_EMAIL="you@example.com"
# JIRA_API_TOKEN="your-jira-api-token"
# GITHUB_PAT="ghp_your-personal-access-token"
